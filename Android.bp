//#######################################
// com.nxp.nfc.nq - library
//#######################################
java_library {
    name: "com.nxp.nfc.nq",
    installable: true,
    required: ["com.nxp.nfc.nq.xml"],
    system_ext_specific: true,

    srcs: [
        "com/**/I*.aidl",
        "com/**/*.java",
        "android/**/*.java",
        // Temp hack until NFC APK can link against module_current.
        ":framework-nfc-updatable-sources",
    ],
    libs: [
      "framework-nfc.impl",
      "unsupportedappusage",
    ]
}

// ====  permissions ========================
prebuilt_etc {
    name: "com.nxp.nfc.nq.xml",
    src: "com.nxp.nfc.nq.xml",
    system_ext_specific: true,
    // Install to /system/etc/permissions
    sub_dir: "permissions",
}
