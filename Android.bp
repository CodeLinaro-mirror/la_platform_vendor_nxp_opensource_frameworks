//#######################################
// com.nxp.nfc.nq - library
//#######################################
prebuilt_etc {
    name: "com.nxp.nfc.nq.xml",
    sub_dir: "permissions",
    src: "com.nxp.nfc.nq.xml",
    system_ext_specific: true,
}

java_library {
    name: "com.nxp.nfc.nq",
    installable: true,
    required: ["com.nxp.nfc.nq.xml"],
    system_ext_specific: true,

    srcs: [
        "com/**/I*.aidl",
        "com/**/*.java",
        "android/**/*.java",
        // TODO(b/263565193): Temp hack until NFC APK can link against module_current.
        //":framework-nfc-updatable-sources",
    ],

    static_libs: ["framework-nfc.impl",],

    libs: [
        "unsupportedappusage",
    ]

}
